{
  "name": "@ui-builder/storybook",
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "sb": "storybook dev -p 6006",
    "build": "storybook build --quiet",
    "serve": "serve -l 6006 -L storybook-static",
    "unittest": "wait-on tcp:6006 && test-storybook --stories-json --maxWorkers=1 --no-cache",
    "unittest:ci": "concurrently -k -s command-TEST -n SERVE,TEST -c magenta,blue npm:serve \"npm:unittest -- --ci\"",
    "storycap": "storycap --serverCmd \"npm run build && npm run serve\" --outDir ../../_storycaps_ http://localhost:6006",
    "storycap:ci": "storycap --serverCmd \"npm run serve\" --outDir ../../_storycaps_ http://localhost:6006",
    "regression": "reg-suit compare",
    "serve:visdiff": "serve -l 3000 ./visdiff-report/"
  },
  "msw": {
    "workerDirectory": "msw-public"
  },
  "dependencies": {
    "@storybook/addon-a11y": "^8.2.2",
    "@storybook/addon-actions": "^8.2.2",
    "@storybook/addon-essentials": "^8.2.2",
    "@storybook/addon-interactions": "^8.2.2",
    "@storybook/addon-links": "^8.2.2",
    "@storybook/addon-themes": "^8.2.2",
    "@storybook/blocks": "^8.2.2",
    "@storybook/react": "^8.2.2",
    "@storybook/react-vite": "^8.2.2",
    "@storybook/react-webpack5": "^8.2.2",
    "@storybook/test": "^8.2.2",
    "@storybook/test-runner": "^0.19.0",
    "@ui-builder/comfybridge": "*",
    "axe-playwright": "^2.0.1",
    "concurrently": "^8.2.2",
    "msw": "2.3.0-ws.rc-7",
    "msw-storybook-addon": "^2.0.2",
    "puppeteer": "^22.13.0",
    "reg-suit": "^0.14.4",
    "serve": "^14.2.3",
    "storybook": "^8.2.2",
    "storycap": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.18.1",
    "@swc/core": "^1.6.13",
    "@swc/core-linux-x64-gnu": "^1.6.13",
    "@swc/core-linux-x64-musl": "^1.6.13"
  }
}
